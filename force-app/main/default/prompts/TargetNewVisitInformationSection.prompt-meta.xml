<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Target New Visit Information Section</masterLabel>
    <promptVersions>
        <body>&lt;p&gt;We&apos;ve added a new section on the page called &lt;strong&gt;Visit Information&lt;/strong&gt; that groups all the visit information for your Target in a single place.  Here you can see the last time you visited, how many days since your last visit, and the number of visits in the last 90 days. 👏&lt;/p&gt;</body>
        <customApplication>PRM</customApplication>
        <delayDays>3</delayDays>
        <description>Highlights the new Visit Information section on the Target page layout.</description>
        <dismissButtonLabel>Mind Blown! 🤯</dismissButtonLabel>
        <displayPosition>MiddleCenter</displayPosition>
        <displayType>FloatingPanel</displayType>
        <endDate>2023-02-10</endDate>
        <isPublished>true</isPublished>
        <masterLabel>Target New Visit Information Section</masterLabel>
        <publishedDate>2023-01-28</publishedDate>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>true</shouldIgnoreGlobalDelay>
        <startDate>2023-01-30</startDate>
        <targetPageKey1>Target__c</targetPageKey1>
        <targetPageKey2>view</targetPageKey2>
        <targetPageType>standard__recordPage</targetPageType>
        <themeColor>Theme1</themeColor>
        <themeSaturation>Light</themeSaturation>
        <timesToDisplay>3</timesToDisplay>
        <title>New Visit Information Section</title>
        <uiFormulaRule>
            <booleanFilter>1 OR 2 OR 3</booleanFilter>
            <criteria>
                <leftValue>{!$User.Profile.Key}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>custom_hc prm prc manager</rightValue>
            </criteria>
            <criteria>
                <leftValue>{!$User.Profile.Key}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>custom_hc prm prc user</rightValue>
            </criteria>
            <criteria>
                <leftValue>{!$User.Profile.Key}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>Admin</rightValue>
            </criteria>
        </uiFormulaRule>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>SpecificProfiles</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
