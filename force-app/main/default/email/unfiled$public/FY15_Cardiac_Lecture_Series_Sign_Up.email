				</td>-->
			</tr>
		</table>
		<table cellpadding="16" cellspacing="0" border="0" align="center" width="674" bgcolor="#e8e9eb">
			<tr><td align="center" valign="center" bgcolor="#000000" colspan="3"><p style="color: white; font-family: arial, helvetica, sans-serif">&copy; 2015 Orlando Health, Inc.</p></td></tr>
		</table>

		</td>
	</tr>
</table>  
