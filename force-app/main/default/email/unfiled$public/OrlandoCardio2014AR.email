<style>

/* Based on The MailChimp Reset INLINE: Yes. */  
		/* Client-specific Styles */
		#outlook a {padding:0;} /* Force Outlook to provide a "view in browser" menu link. */
		body{width:100% !important; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; margin:0; padding:0; background-color:#EFEFEF;} 
		/* Prevent Webkit and Windows Mobile platforms from changing default font sizes.*/ 
		.ExternalClass {width:100%;} /* Force Hotmail to display emails at full width */  
		.ExternalClass, .ExternalClass p, .ExternalClass span, .ExternalClass font, .ExternalClass td, .ExternalClass div {line-height: 100%;}
		/* Forces Hotmail to display normal line spacing.  More on that: http://www.emailonacid.com/forum/viewthread/43/ */ 
		#backgroundTable {margin:0; padding:0; width:100% !important; line-height: 100% !important; background-color:#EFEFEF;}
		/* End reset */

		/* Some sensible defaults for images
		Bring inline: Yes. */
		img {outline:none; text-decoration:none; -ms-interpolation-mode: bicubic;} 
		a img {border:none;} 
		.image_fix {display:block;}

		/* Yahoo paragraph fix
		Bring inline: Yes. */
		p {margin: 1em 0;}

		/* Outlook 07, 10 Padding issue fix
		Bring inline: No.*/
		table td {border-collapse: collapse;}
		
		/* Prevent Webkit and Windows Mobile platforms from changing default font sizes, while not breaking desktop design. */
		.ExternalClass {width:100%;}

h1 {
	font-family:Helvetica, Arial, sans-serif;
	color:#333333;
	font-size:40px;
}

p {
	font-family:Georgia, Times New Roman, Times, serif;
	font-size:14px;
	line-height:22px;
	color:#333333;
}

.footer {
	font-family:Georgia, Times New Roman, Times, serif;
	font-size:11px;
	line-height:13px;
	color:#333333;
	text-align:center;
	font-style:italic;
}

.white {
	font-family:Helvetica, Arial, sans-serif;
	font-size:29px;
	line-height:32px;
	color:#FFFFFF;
	margin:0;
}

.white-sub {
	font-family:Helvetica, Arial, sans-serif;
	font-size:16px;
	line-height:22px;
	color:#FFFFFF;
}

.blog {
	font-family:Helvetica, Arial, sans-serif;
	font-size:29px;
	line-height:32px;
	color:#333333;
	margin:0;
	font-weight:bold;
}

a {
	color:#9E1933;
}

@media only screen and (max-device-width: 480px) {
        table[class="wrapper"]{
          width:100% !important;
        }
        td[class="logo"]{
          text-align: center !important;
        }
		img[class="logo"]{
		  max-width: 100% !important;
		  height: auto !important;
		}
		td[class="sub-head"]{
          text-align: center !important;
		  font-size:20px !important;
        }
		p[class="copy"]{
          
        }
        td[class="mobile-hide"]{
          display:none;
        }
        img[class="mobile-hide"]{
          display: none !important;
        }
}
</style>

</head>

