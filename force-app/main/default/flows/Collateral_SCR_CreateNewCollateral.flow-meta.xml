    <description>A screen flow to create a new collateral record and upload a file in the same process.</description>
    <environments>Default</environments>
    <formulas>
        <name>fB_TurnOffFileUpload</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!S02_FILE01_UploadCollateral.fileNames}))</expression>
    </formulas>
    <formulas>
        <name>fT_FormattedErrorMessage</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!$Flow.FaultMessage}),
  &quot;An unknown error occurred while saving the record.&quot;,
  SUBSTITUTE(
    SUBSTITUTE(
      SUBSTITUTE(
        LEFT(
          {!$Flow.FaultMessage},
          FIND(&quot;. You can look up&quot;, {!$Flow.FaultMessage} &amp; &quot;. You can look up&quot;) - 1
        ),
        &quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;,
        &quot;&quot;
      ),
      &quot;REQUIRED_FIELD_MISSING: &quot;,
      &quot;&quot;
    ),
    &quot;This error occurred when the flow tried to create records: &quot;,
    &quot;&quot;
  )
)</expression>
    </formulas>
    <formulas>
        <name>fT_FormattedFileName</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE({!S02_FILE01_UploadCollateral.fileNames},&quot;[&quot;,&quot;&quot;),&quot;]&quot;,&quot;&quot;)</expression>
    </formulas>
