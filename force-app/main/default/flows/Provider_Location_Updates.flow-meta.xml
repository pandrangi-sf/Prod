    <description>Process for when a Provider Location is created/updated.  Creates a related P&amp;G if one doesn&apos;t exist, and makes updates if location is marked as primary.</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaPrimaryLocationUpdated</name>
        <dataType>Boolean</dataType>
        <expression>AND({!$Record.Primary__c}=TRUE,OR(ISNEW(),{!$Record__Prior.Primary__c}=FALSE))</expression>
    </formulas>
    <formulas>
        <description>Checks if this is a new record.</description>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
