    <decisions>
        <name>Check_Alert_Type</name>
        <label>Check Alert Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Send_Default_Email</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Gap_Detection</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vT_alertType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Gap Detection</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Gap_Detection_Email</targetReference>
            </connector>
            <label>Gap Detection</label>
        </rules>
        <rules>
            <name>Error</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vT_alertType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Error</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Error_Email</targetReference>
            </connector>
            <label>Error</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fT_FormattedSubject</name>
