<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Location_to_Collection</name>
        <label>Add Location to Collection</label>
        <locationX>264</locationX>
        <locationY>468</locationY>
        <assignmentItems>
            <assignToReference>collVisitLocations</assignToReference>
            <operator>RemoveAll</operator>
            <value>
                <elementReference>For_Each_Visit_Record.WhatId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>collVisitLocations</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>For_Each_Visit_Record.WhatId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>For_Each_Visit_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Location_Visit_Record_to_Collection</name>
        <label>Add Location Visit Record to Collection</label>
        <locationX>264</locationX>
        <locationY>876</locationY>
        <assignmentItems>
            <assignToReference>collLocationVisitRecords</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>LocationVisitRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>For_Each_Location</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_to_Location_Visit_Record</name>
        <label>Add to Location Visit Record</label>
        <locationX>264</locationX>
        <locationY>768</locationY>
        <assignmentItems>
            <assignToReference>LocationVisitRecord.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LocationVisitRecord.Location__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>For_Each_Location</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Location_Visit_Record_to_Collection</targetReference>
        </connector>
    </assignments>
    <description>Scheduled flow to create initial Location Visit Records.</description>
    <environments>Default</environments>
    <formulas>
        <name>formula90DaysPriorDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()-90</expression>
    </formulas>
    <interviewLabel>Create All Location Visit Records {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create All Location Visit Records</label>
    <loops>
        <name>For_Each_Location</name>
        <label>For Each Location</label>
        <locationX>176</locationX>
        <locationY>660</locationY>
        <collectionReference>collVisitLocations</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_to_Location_Visit_Record</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Location_Visit_Records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>For_Each_Visit_Record</name>
        <label>For Each Visit Record</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <collectionReference>Get_Visit_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Location_to_Collection</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>For_Each_Location</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Location_Visit_Records</name>
        <label>Create Location Visit Records</label>
        <locationX>176</locationX>
        <locationY>1068</locationY>
        <inputReference>collLocationVisitRecords</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Visit_Records</name>
        <label>Get Visit Records</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>For_Each_Visit_Record</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND (3 OR 4)</filterLogic>
        <filters>
            <field>OwnerId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Date_Meeting_Call__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>formula90DaysPriorDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>012i0000001NJcBAAW</stringValue>
            </value>
        </filters>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>012i0000001NDwAAAW</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Visit_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Department_License__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PRM</stringValue>
            </value>
        </filters>
        <filters>
            <field>Alias</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>karri</stringValue>
            </value>
        </filters>
        <object>User</object>
        <schedule>
            <frequency>Once</frequency>
            <startDate>2023-06-14</startDate>
            <startTime>18:27:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
    <textTemplates>
        <name>textLocationVisitsLast90DaysQueryString</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>SELECT Id, Task.ActivityDate, Task.Date_Meeting_Call__c
FROM TaskWhoRelation
WHERE Task.OwnerId = &apos;{!$Record.Id}&apos; AND Task.RecordTypeId IN (&apos;012i0000001NDwAAAW&apos;,&apos;012i0000001NJcBAAW&apos;) AND Task.Date_Meeting_Call__c = LAST_90_DAYS
ORDER BY Task.ActivityDate DESC</text>
    </textTemplates>
    <variables>
        <name>collLocationVisitRecords</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Location_Visit__c</objectType>
    </variables>
    <variables>
        <name>collVisitLocations</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>LocationVisitRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Location_Visit__c</objectType>
    </variables>
</Flow>
