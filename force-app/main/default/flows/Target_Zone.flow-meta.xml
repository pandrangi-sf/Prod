<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Updates the Target Zone Key field on all Target Zones.</description>
    <environments>Default</environments>
    <formulas>
        <name>TargetZoneKey</name>
        <dataType>String</dataType>
        <expression>{!$Record.OwnerId} + &quot;-&quot; + {!$Record.TargetLocation__c}</expression>
    </formulas>
    <interviewLabel>Target Zone: {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Target Zone: Update All Target Zone Key Fields</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Target_Zone_Key_Field</name>
        <label>Update Target Zone Key Field</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <inputAssignments>
            <field>ZonedLocationKey__c</field>
            <value>
                <elementReference>TargetZoneKey</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Target_Zone_Key_Field</targetReference>
        </connector>
        <object>ZonedLocation__c</object>
        <schedule>
            <frequency>Once</frequency>
            <startDate>2022-11-27</startDate>
            <startTime>21:15:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
