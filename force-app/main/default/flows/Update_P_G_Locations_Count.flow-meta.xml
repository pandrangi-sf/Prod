<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Count_Locations</name>
        <label>Count Locations</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <assignmentItems>
            <assignToReference>NumberOfLocations</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Related_Locations</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_P_G_Location_Count</targetReference>
        </connector>
    </assignments>
    <description>Counts the number of Location records related to a P&amp;G and updates the Location Count field on the P&amp;G.</description>
    <environments>Default</environments>
    <interviewLabel>Update P&amp;G Locations Count {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update P&amp;G Locations Count</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Related_Locations</name>
        <label>Get Related Locations</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_Locations</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Practice__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Location__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_P_G_Location_Count</name>
        <label>Update P&amp;G Location Count</label>
        <locationX>176</locationX>
        <locationY>468</locationY>
        <inputAssignments>
            <field>Number_of_Locations__c</field>
            <value>
                <elementReference>NumberOfLocations</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Related_Locations</targetReference>
        </connector>
        <object>Account</object>
        <schedule>
            <frequency>Once</frequency>
