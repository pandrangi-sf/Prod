    <textTemplates>
        <name>TT_LocationLastVisitQueryString</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>SELECT ActivityDate, Date_Meeting_Call__c
FROM Task
WHERE OwnerId = &apos;{!viT_TerritoryOwner}&apos; AND WhatId = &apos;{!viT_Location}&apos; AND RecordType.DeveloperName IN (&apos;VisitReportPhysicianSales&apos;, &apos;Virtual_Visit_Physician_Sales&apos;)
ORDER BY Task.Date_Meeting_Call__c DESC Limit 1</text>
    </textTemplates>
    <textTemplates>
        <name>TT_LocationVisitsLast90DaysQueryString</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>SELECT Id, ActivityDate, Date_Meeting_Call__c
FROM Task
WHERE OwnerId = &apos;{!viT_TerritoryOwner}&apos; AND WhatId = &apos;{!viT_Location}&apos; AND RecordType.DeveloperName IN (&apos;VisitReportPhysicianSales&apos;, &apos;Virtual_Visit_Physician_Sales&apos;) AND Date_Meeting_Call__c = LAST_90_DAYS
ORDER BY ActivityDate DESC</text>
    </textTemplates>
    <textTemplates>
        <name>TT_TargetLastVisitQueryString</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>SELECT Task.ActivityDate, Task.Date_Meeting_Call__c
