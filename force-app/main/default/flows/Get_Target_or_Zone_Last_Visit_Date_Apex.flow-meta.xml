WHERE RelationId = &apos;{!viT_TargetProvider}&apos; AND Task.OwnerId = &apos;{!viT_TerritoryOwner}&apos; AND Task.RecordType.DeveloperName IN (&apos;VisitReportPhysicianSales&apos;,&apos;Virtual_Visit_Physician_Sales&apos;)
