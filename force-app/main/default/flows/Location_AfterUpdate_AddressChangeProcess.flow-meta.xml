<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Primary_Provider_Count</name>
        <label>Assign Primary Provider Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>vN_CountPrimaryProviders</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Primary_Providers</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Any_Primary_Providers</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Provider_to_Collection</name>
        <label>Assign Provider to Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>vR_Providers</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>vR_Provider</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Providers</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Provider_Variables</name>
        <label>Assign Provider Variables</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>vR_Provider.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Through_Providers.Provider__r.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>vR_Provider.MailingStreet</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Address__Street__s</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>vR_Provider.MailingCity</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Address__City__s</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>vR_Provider.MailingState</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Address__StateCode__s</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>vR_Provider.MailingPostalCode</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Address__PostalCode__s</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>vR_Provider.MailingCountry</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Address__CountryCode__s</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Provider_to_Collection</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Any_Primary_Providers</name>
        <label>Any Primary Providers?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Primary Providers</defaultConnectorLabel>
        <rules>
            <name>Yes_Primary_Providers</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vN_CountPrimaryProviders</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Through_Providers</targetReference>
            </connector>
            <label>Yes Primary Providers</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Primary_Location</name>
        <label>Is Primary Location?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Primary_Providers</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Primary Location</defaultConnectorLabel>
        <rules>
            <name>Primary_Location</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Primary__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Practice_Group_Address</targetReference>
            </connector>
            <label>Primary Location</label>
        </rules>
    </decisions>
    <description>Updates the address for related Practice &amp; Group and Providers.</description>
    <environments>Default</environments>
    <interviewLabel>Location_AfterUpdate_AddressChangeProcess {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Location_AfterUpdate_AddressChangeProcess</label>
    <loops>
        <name>Loop_Through_Providers</name>
        <label>Loop Through Providers</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Primary_Providers</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Provider_Variables</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Providers</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get Providers who have this as their primary location.</description>
        <name>Get_Primary_Providers</name>
        <label>Get Primary Providers</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Primary_Provider_Count</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Location__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Primary__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ProviderLocation__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Practice_Group_Address</name>
        <label>Update Practice &amp; Group Address</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Primary_Providers</targetReference>
        </connector>
        <inputAssignments>
            <field>ShippingCity</field>
            <value>
                <elementReference>$Record.Address__City__s</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ShippingCountry</field>
            <value>
                <elementReference>$Record.Address__CountryCode__s</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ShippingPostalCode</field>
            <value>
                <elementReference>$Record.Address__PostalCode__s</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ShippingState</field>
            <value>
                <elementReference>$Record.Address__StateCode__s</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ShippingStreet</field>
            <value>
                <elementReference>$Record.Address__Street__s</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Practice__r</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Providers</name>
        <label>Update Providers</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>vR_Providers</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Primary_Location</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Address__Street__s</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Address__City__s</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Address__StateCode__s</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Address__PostalCode__s</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Address__CountryCode__s</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Location__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>vN_CountPrimaryProviders</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>vR_Provider</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <name>vR_Providers</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
</Flow>
