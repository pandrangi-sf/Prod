<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Updates the Target Key field when records are created or updated.</description>
    <environments>Default</environments>
    <formulas>
        <description>Calculates the value for the Target Key.</description>
        <name>fT_TargetKey</name>
        <dataType>String</dataType>
        <expression>{!$Record.Territory__r.OwnerId} + &quot;-&quot; + {!$Record.Target_Provider__c} + &quot;-&quot; + {!$Record.Territory__r.Id}</expression>
    </formulas>
    <interviewLabel>Target_ {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Target_BeforeCreateUpdate_UpdateTargetKeyField</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Updates the value in the Target Key Field.</description>
        <name>Update_Target_Key</name>
        <label>Update Target Key</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <inputAssignments>
            <field>Target_Key__c</field>
            <value>
                <elementReference>fT_TargetKey</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Target_Key</targetReference>
        </connector>
        <object>Target__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
