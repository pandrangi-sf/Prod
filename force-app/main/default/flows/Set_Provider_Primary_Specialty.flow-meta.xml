<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Updates the Primary Specialty field on the Provider record when a record on the Provider Specialty related list is set as Primary.</description>
    <environments>Default</environments>
    <interviewLabel>Set Provider Primary Specialty {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Set Provider Primary Specialty</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Remove_Primary_from_Other_Specialties</name>
        <label>Remove Primary from Other Specialties</label>
        <locationX>176</locationX>
        <locationY>455</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Provider__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Provider__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Primary__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Primary__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>ProviderSpecialty__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Provider_Primary_Specialty</name>
        <label>Update Provider Primary Specialty</label>
        <locationX>176</locationX>
        <locationY>335</locationY>
        <connector>
            <targetReference>Remove_Primary_from_Other_Specialties</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Provider__r.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>PrimarySpecialty__c</field>
            <value>
                <elementReference>$Record.Specialty__r.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Contact</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Provider_Primary_Specialty</targetReference>
        </connector>
        <filterFormula>AND({!$Record.Primary__c}=TRUE,OR(ISNEW(),{!$Record__Prior.Primary__c}=FALSE))</filterFormula>
        <object>ProviderSpecialty__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
