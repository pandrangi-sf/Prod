<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>[Entry=None] A scheduled flow that runs weekly and updates the &quot;Update Last Visit Date&quot; field on all Zoned Locations to trigger the flow to update the last visit information.  This is done so the &quot;Visit Last 90 days&quot; field gets updated.</description>
    <environments>Default</environments>
    <interviewLabel>ZonedLocation_SCH_UpdateLastVisitInformation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ZonedLocation_SCH_UpdateLastVisitInformation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Update the &quot;Update Last Visit Date&quot; field to TRUE to trigger the flows to update the last visit information.</description>
        <name>Set_Update_Last_Visit_Date_Field</name>
        <label>Set Update Last Visit Date Field</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <inputAssignments>
            <field>Update_Last_Visit_Date__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Update_Last_Visit_Date_Field</targetReference>
        </connector>
        <object>ZonedLocation__c</object>
        <schedule>
            <frequency>Once</frequency>
            <startDate>2024-06-14</startDate>
            <startTime>14:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
</Flow>
