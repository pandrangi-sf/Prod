<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Flow is triggered when the Update Last Visit Date field is set to true.  Used to update all Targets by setting that field on all records.</description>
    <environments>Default</environments>
    <interviewLabel>Target_AfterUpdate_UpdateLastVisitDate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Target_AfterUpdate_UpdateLastVisitDate</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Target_Record</name>
        <label>Update Target Record</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>Target_Last_Visit__c</field>
            <value>
                <elementReference>Get_Target_Last_Visit_Date.voD_LastVisitDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Update_Last_Visit_Date__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Visits_Last_90_Days__c</field>
            <value>
                <elementReference>Get_Target_Last_Visit_Date.voN_CountOfVisitsLast90Days</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Target_Last_Visit_Date</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Update_Last_Visit_Date__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Update_Last_Visit_Date__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Target__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <description>Gets the most recent visit date for the Target.</description>
        <name>Get_Target_Last_Visit_Date</name>
        <label>Get Target Last Visit Date</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <connector>
            <targetReference>Update_Target_Record</targetReference>
        </connector>
        <flowName>Get_Target_or_Zone_Last_Visit_Date_Apex</flowName>
        <inputAssignments>
            <name>viT_RequestType</name>
            <value>
                <stringValue>Target</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>viT_TargetOwner</name>
            <value>
                <elementReference>$Record.Territory__r.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>viT_TargetProvider</name>
            <value>
                <elementReference>$Record.Target_Provider__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>viT_TerritoryOwner</name>
            <value>
                <elementReference>$Record.Territory__r.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
</Flow>
