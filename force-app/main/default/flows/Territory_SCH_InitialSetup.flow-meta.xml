        <locationX>176</locationX>
        <locationY>252</locationY>
        <flowName>Territory_SUB_InitalSetUp</flowName>
        <inputAssignments>
            <name>viT_Territory</name>
            <value>
                <elementReference>$Record.Name</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
