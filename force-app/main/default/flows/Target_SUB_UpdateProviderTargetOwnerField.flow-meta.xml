        <expression>CONTAINS({!vT_TargetOwnerIDs},{!Loop_Through_Targets.Territory_Owner_Id__c})</expression>
    </formulas>
    <formulas>
        <name>fT_FormattedTargetOwnerIDs</name>
        <dataType>String</dataType>
        <expression>LEFT({!vT_TargetOwnerIDs}, LEN({!vT_TargetOwnerIDs})-2)</expression>
    </formulas>
    <formulas>
        <name>fT_FormattedUserID</name>
        <dataType>String</dataType>
        <expression>LEFT( {!Loop_Through_Targets.Territory_Owner_Id__c}, 15)</expression>
