    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Updates the Target Key field when records are created or updated.</description>
    <environments>Default</environments>
    <formulas>
        <name>TargetKey</name>
        <dataType>String</dataType>
        <expression>{!$Record.OwnerId} + &quot;-&quot; + {!$Record.Target_Provider__c} + &quot;-&quot; + TEXT({!$Record.Facility__c})</expression>
    </formulas>
    <interviewLabel>Target: Update Target Key Field {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Target: Update Target Key Field</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Target_Key</name>
        <label>Update Target Key</label>
        <locationX>176</locationX>
        <locationY>311</locationY>
        <inputAssignments>
            <field>Target_Key__c</field>
            <value>
                <elementReference>TargetKey</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Target_Key</targetReference>
        </connector>
        <object>Target__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
