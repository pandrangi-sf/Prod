<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Checks if the Primary checkbox was updated</description>
        <name>Primary_Updated</name>
        <label>Primary Updated</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Update_Practice_Group_Primary_Location</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Set_as_Primary</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Primary__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Primary__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_Primary_from_Other_Locations</targetReference>
            </connector>
            <label>Set as Primary</label>
        </rules>
    </decisions>
    <decisions>
        <name>Update_Practice_Group_Fields_Check</name>
        <label>Update Practice &amp; Group Fields Check</label>
        <locationX>182</locationX>
        <locationY>731</locationY>
        <defaultConnectorLabel>Do Not Update Fields</defaultConnectorLabel>
        <rules>
            <name>Update_Fields</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Practice__r.DoNotUpdateFromPrimaryLocation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Practice_Group_Fields</targetReference>
            </connector>
            <label>Update Fields</label>
        </rules>
    </decisions>
    <description>When a Location (OH) is set as primary it removes the primary flag from other locations and updates the Practice &amp; Group Primary Location field.</description>
    <environments>Default</environments>
    <interviewLabel>Primary Location Updated {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Primary Location Updated</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Remove_Primary_from_Other_Locations</name>
        <label>Remove Primary from Other Locations</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>Update_Practice_Group_Primary_Location</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Practice__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Practice__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Primary__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Primary__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Location__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Practice_Group_Fields</name>
        <label>Update Practice &amp; Group Fields</label>
        <locationX>50</locationX>
        <locationY>839</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Practice__r.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ShippingCity</field>
            <value>
                <elementReference>$Record.Address__City__s</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ShippingPostalCode</field>
            <value>
                <elementReference>$Record.Address__PostalCode__s</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ShippingState</field>
            <value>
                <elementReference>$Record.Address__StateCode__s</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ShippingStreet</field>
            <value>
                <elementReference>$Record.Address__Street__s</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <recordUpdates>
        <description>Updates the Primary Location field on the related Practice &amp; Group</description>
        <name>Update_Practice_Group_Primary_Location</name>
        <label>Update Practice &amp; Group Primary Location</label>
        <locationX>182</locationX>
        <locationY>623</locationY>
        <connector>
            <targetReference>Update_Practice_Group_Fields_Check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Practice__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>PrimaryLocation__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Primary_Updated</targetReference>
        </connector>
        <filterFormula>AND({!$Record.Primary__c}=TRUE,OR(ISNEW(),{!$Record__Prior.Primary__c}=FALSE))</filterFormula>
        <object>Location__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
