<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Updated_Epic_to_Collectoion</name>
        <label>Add Updated Epic to Collectoion</label>
        <locationX>490</locationX>
        <locationY>755</locationY>
        <assignmentItems>
            <assignToReference>collectionUpdatedEpicRecords</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>vR_CurrentEpic</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Priority_for_each_Epic</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_New_Record_Priority</name>
        <label>Assign New Record Priority</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <assignmentItems>
            <assignToReference>vN_NewRecordPriority</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Lowest_Priority_Open_Epic_Record.agf__Priority__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>vN_NewRecordPriority</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_New_Record_Priority</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Update_New_Priority_Value</name>
        <label>Update New Priority Value</label>
        <locationX>490</locationX>
        <locationY>647</locationY>
        <assignmentItems>
            <assignToReference>vN_StartingPriorityValue</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>vN_NewRecordPriority</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>vN_StartingPriorityValue</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>vR_CurrentEpic.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Update_Priority_for_each_Epic.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>vR_CurrentEpic.agf__Priority__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>vN_NewRecordPriority</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Updated_Epic_to_Collectoion</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Checks if the priority is populated on the record.</description>
        <name>Is_the_Priority_populated</name>
        <label>Is the Priority populated?</label>
        <locationX>226</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Get_Open_Epics_with_Greater_Than_or_Equal_Priority</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Populated</defaultConnectorLabel>
        <rules>
            <name>Not_Populated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fB_PriorityNotPopulated</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Lowest_Priority_Open_Epic_Record</targetReference>
            </connector>
            <label>Not Populated</label>
        </rules>
    </decisions>
    <description>Flow updates the open epics priorities whenever a new record is created or an existing record is changed.</description>
    <environments>Default</environments>
    <formulas>
        <name>fB_IsNewRecord</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>fB_PriorityNotPopulated</name>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!$Record.agf__Priority__c})</expression>
    </formulas>
    <interviewLabel>Epic: Update Priorities {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Epic: Update Priorities</label>
    <loops>
        <description>Loops through each epic record and updates the priority</description>
        <name>Update_Priority_for_each_Epic</name>
        <label>Update Priority for each Epic</label>
        <locationX>402</locationX>
        <locationY>539</locationY>
        <collectionReference>Get_Open_Epics_with_Greater_Than_or_Equal_Priority</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Update_New_Priority_Value</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Epics_with_New_Priority</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Queries the Epic records for those that are not Completed or Cancelled and gets the record with the lowest priority value.</description>
        <name>Get_Lowest_Priority_Open_Epic_Record</name>
        <label>Get Lowest Priority Open Epic Record</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_New_Record_Priority</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>agf__Health__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>agf__Health__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Canceled</stringValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>agf__Team__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.agf__Team__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>agf__ADM_Epic__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>agf__Priority__c</queriedFields>
        <queriedFields>Name</queriedFields>
        <sortField>agf__Priority__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Query the open Epics for any records that have the same or a greater priority number than the updated record.</description>
        <name>Get_Open_Epics_with_Greater_Than_or_Equal_Priority</name>
        <label>Get Open Epics with Greater Than or Equal Priority</label>
        <locationX>402</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Priority_for_each_Epic</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>agf__Priority__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>$Record.agf__Priority__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>agf__Health__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>agf__Health__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Canceled</stringValue>
            </value>
        </filters>
        <filters>
            <field>agf__Team__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.agf__Team__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>agf__ADM_Epic__c</object>
        <sortField>agf__Priority__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Epics_with_New_Priority</name>
        <label>Update Epics with New Priority</label>
        <locationX>402</locationX>
        <locationY>947</locationY>
        <inputReference>collectionUpdatedEpicRecords</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_New_Record_Priority</name>
        <label>Update New Record Priority</label>
        <locationX>50</locationX>
        <locationY>647</locationY>
        <inputAssignments>
            <field>agf__Priority__c</field>
            <value>
                <elementReference>vN_NewRecordPriority</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>100</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_the_Priority_populated</targetReference>
        </connector>
        <filterFormula>AND(TEXT({!$Record.agf__Health__c})&lt;&gt;&apos;Completed&apos;,
TEXT({!$Record.agf__Health__c})&lt;&gt;&apos;Canceled&apos;,
OR(ISCHANGED({!$Record.agf__Priority__c}),ISBLANK({!$Record.agf__Priority__c})))</filterFormula>
        <object>agf__ADM_Epic__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>collectionUpdatedEpicRecords</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>agf__ADM_Epic__c</objectType>
    </variables>
    <variables>
        <name>vN_NewRecordPriority</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <description>The priority value of the triggering Epic record</description>
        <name>vN_StartingPriorityValue</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <elementReference>$Record.agf__Priority__c</elementReference>
        </value>
    </variables>
    <variables>
        <name>vR_CurrentEpic</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>agf__ADM_Epic__c</objectType>
    </variables>
</Flow>
