<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Update_Provider_Fields_Check</name>
        <label>Update Provider Fields Check</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Do Not Update Fields</defaultConnectorLabel>
        <rules>
            <name>Update_Fields</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Provider__r.DoNotUpdateFromPrimaryLocation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Provider_Fields</targetReference>
            </connector>
            <label>Update Fields</label>
        </rules>
    </decisions>
    <description>Removes the primary flag from other locations, sets the Provider Primary Location field, and updates the provider mailing address</description>
    <environments>Default</environments>
    <interviewLabel>Provider Primary Location Updated {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Provider Primary Location Updated</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Remove_Primary_from_Other_Locations</name>
        <label>Remove Primary from Other Locations</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <connector>
            <targetReference>Update_Provider_Primary_Location</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Provider__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Provider__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Primary__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Primary__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>ProviderLocation__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Provider_Fields</name>
        <label>Update Provider Fields</label>
        <locationX>50</locationX>
        <locationY>647</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Provider__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>MailingCity</field>
            <value>
                <elementReference>$Record.Location__r.Address__City__s</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>MailingPostalCode</field>
            <value>
                <elementReference>$Record.Location__r.Address__PostalCode__s</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>MailingState</field>
            <value>
                <elementReference>$Record.Location__r.Address__StateCode__s</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>MailingStreet</field>
            <value>
                <elementReference>$Record.Location__r.Address__Street__s</elementReference>
            </value>
        </inputAssignments>
        <object>Contact</object>
    </recordUpdates>
    <recordUpdates>
        <description>Updates the Primary Location field on the related Provider</description>
        <name>Update_Provider_Primary_Location</name>
        <label>Update Provider Primary Location</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>Update_Provider_Fields_Check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Provider__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>PrimaryLocation__c</field>
            <value>
                <elementReference>$Record.Location__r.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Contact</object>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Remove_Primary_from_Other_Locations</targetReference>
        </connector>
        <filterFormula>AND({!$Record.Primary__c}=TRUE,OR(ISNEW(),{!$Record__Prior.Primary__c}=FALSE))</filterFormula>
        <object>ProviderLocation__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
