        </defaultConnector>
        <defaultConnectorLabel>Create New Issue</defaultConnectorLabel>
        <rules>
            <name>Attach_To_Existing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>S02_RB_Path</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Existing</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Case_Id_Existing</targetReference>
            </connector>
            <label>Attach To Existing</label>
        </rules>
    </decisions>
    <description>Groups Visit Objection reports into a Provider Objection Case. Launched as a quick action from a report. Many reports to zero-or-one issue: the reviewer decides, which is deliberate in the design, so nothing is auto-grouped.</description>
    <dynamicChoiceSets>
        <description>Open issues already raised for the same objection theme, so repeat reports land on the existing issue instead of creating duplicates.</description>
        <name>rcs_Open_Cases</name>
        <dataType>String</dataType>
        <displayField>Subject</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Objection__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_This_Report.Objection__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <sortField>Subject</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <description>Default subject: the theme plus the practice group it was raised at.</description>
        <name>fT_DefaultSubject</name>
        <dataType>String</dataType>
        <expression>{!Get_This_Report.Objection__r.Name} &amp; " - " &amp; {!Get_This_Report.Practice_Group__r.Name}</expression>
    </formulas>
    <interviewLabel>Visit Objection SCR Group Into Case {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Visit Objection SCR Group Into Case</label>
    <loops>
