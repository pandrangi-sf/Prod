    <decisions>
        <description>A report can belong to only one issue. If it is already grouped, stop and say so rather than silently moving it.</description>
        <name>Already_Grouped</name>
        <label>Already Grouped?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Similar_Ungrouped</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Grouped Yet</defaultConnectorLabel>
        <rules>
            <name>Is_Already_Grouped</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_This_Report.Case__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>S01_Already_Grouped</targetReference>
            </connector>
            <label>Already Grouped</label>
        </rules>
    </decisions>
    <decisions>
        <description>New issue or attach to an existing one.</description>
