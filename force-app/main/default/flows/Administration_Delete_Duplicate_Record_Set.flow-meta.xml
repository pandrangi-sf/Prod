<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Deletes a Duplicate Record set when it has 1 or fewer records.</description>
    <environments>Default</environments>
    <interviewLabel>Administration: Delete Duplicate Record Set {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Administration: Delete Duplicate Record Set</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordDeletes>
        <description>Deletes the Duplicate Record Set when it has 1 or less records.</description>
        <name>Delete_Duplicate_Record_Set</name>
        <label>Delete Duplicate Record Set</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <inputReference>$Record</inputReference>
    </recordDeletes>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Delete_Duplicate_Record_Set</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RecordCount</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </filters>
        <object>DuplicateRecordSet</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
