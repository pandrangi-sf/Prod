<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>ProviderDataChangesGroupId</name>
        <dataType>String</dataType>
        <value>
            <stringValue>0F96e0000010wiKCAQ</stringValue>
        </value>
    </constants>
    <description>Post to the Provider Data Changes Group when a new request is submitted.</description>
    <environments>Default</environments>
    <formulas>
        <name>RecordLink</name>
        <dataType>String</dataType>
        <expression>&quot;https://orlandohealth.my.salesforce.com&quot;&amp;&quot;/&quot;&amp;{!$Record.Id}</expression>
    </formulas>
    <interviewLabel>Provider Data Change Alert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Provider Data Change Alert</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Chatter_Post</name>
        <label>Create Chatter Post</label>
        <locationX>176</locationX>
        <locationY>335</locationY>
        <inputAssignments>
            <field>Body</field>
            <value>
                <elementReference>ChatterPost_RichText</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsRichText</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ParentId</field>
            <value>
                <elementReference>ProviderDataChangesGroupId</elementReference>
            </value>
        </inputAssignments>
        <object>FeedItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Chatter_Post</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>0126e000001tYhwAAE</stringValue>
            </value>
        </filters>
        <object>Task</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>ChatterPost_RichText</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>&lt;p&gt;There is a new provider data change request.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Subject:&lt;/b&gt; {!$Record.Subject}&lt;/p&gt;&lt;p&gt;&lt;b&gt;Type:&lt;/b&gt; {!$Record.Type}&lt;/p&gt;&lt;p&gt;&lt;b&gt;Due Date:&lt;/b&gt; {!$Record.ActivityDate}&lt;/p&gt;&lt;p&gt;&lt;b&gt;Comments:&lt;/b&gt; {!$Record.Description}&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&amp;nbsp;&lt;p&gt;&lt;a href=&quot;{!RecordLink}&quot;&gt;Click to Open Task&lt;/a&gt;&lt;/p&gt;</text>
    </textTemplates>
</Flow>
