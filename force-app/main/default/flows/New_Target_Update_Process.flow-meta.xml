<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>When a new target is created this flow will update the Last Visit Date field and update any related Target Zones with this Target.</description>
    <environments>Default</environments>
    <interviewLabel>New Target Update Process {!$Flow.CurrentDateTime}</interviewLabel>
    <label>New Target Update Process</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Last_Visit_Date_Field</name>
        <label>Update Last Visit Date Field</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>Update_Related_Target_Zones</targetReference>
        </connector>
        <inputAssignments>
            <field>Target_Last_Visit__c</field>
            <value>
                <elementReference>Get_Target_Last_Visit_Date.outputLastVisitDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Visits_Last_90_Days__c</field>
            <value>
                <elementReference>Get_Target_Last_Visit_Date.outputNumberCountOfVisitsLast90Days</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Updates the Target field on any related Target Zone records</description>
        <name>Update_Related_Target_Zones</name>
        <label>Update Related Target Zones</label>
        <locationX>176</locationX>
        <locationY>539</locationY>
        <connector>
            <targetReference>Update_Provider_Target_Owner_Field</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Provider__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Target_Provider__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>OwnerId__NotFound</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OwnerId__NotFound</elementReference>
            </value>
        </filters>
        <filters>
            <field>Facility__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Facility__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Target__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>ZonedLocation__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Target_Last_Visit_Date</targetReference>
        </connector>
        <object>Target__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <subflows>
        <name>Get_Target_Last_Visit_Date</name>
        <label>Get Target Last Visit Date</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <connector>
            <targetReference>Update_Last_Visit_Date_Field</targetReference>
        </connector>
        <flowName>Get_Target_or_Zone_Last_Visit_Date_Apex</flowName>
        <inputAssignments>
            <name>inputRequestType</name>
            <value>
                <stringValue>Target</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inputTargetOwner</name>
            <value>
                <elementReference>$Record.OwnerId__NotFound</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inputTargetProvider</name>
            <value>
                <elementReference>$Record.Target_Provider__c</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <subflows>
        <name>Update_Provider_Target_Owner_Field</name>
        <label>Update Provider Target Owner Field</label>
        <locationX>176</locationX>
        <locationY>647</locationY>
        <flowName>Update_Provider_Target_Owner_Field</flowName>
        <inputAssignments>
            <name>txtProviderID</name>
            <value>
                <elementReference>$Record.Target_Provider__r.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
