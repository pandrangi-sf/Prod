<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Triggered when the Update Last Visit Date field is checked.  Workflow will find the last visit date and update the field.</description>
    <environments>Default</environments>
    <interviewLabel>ZonedLocation_AfterUpdate_UpdateLastVisitDate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ZonedLocation_AfterUpdate_UpdateLastVisitDate</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Update the Last Visit Date on the Zoned Location</description>
        <name>Update_Zoned_Location_Record</name>
        <label>Update Zoned Location Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>LastVisitDate__c</field>
            <value>
                <elementReference>Get_Zoned_Location_Last_Visit_Date.voD_LastVisitDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Update_Last_Visit_Date__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Visits_Last_90_Days__c</field>
            <value>
                <elementReference>Get_Zoned_Location_Last_Visit_Date.voN_CountOfVisitsLast90Days</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Zoned_Location_Last_Visit_Date</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Update_Last_Visit_Date__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Update_Last_Visit_Date__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>ZonedLocation__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <description>Gets the last visit date for the Target Zone</description>
        <name>Get_Zoned_Location_Last_Visit_Date</name>
        <label>Get Zoned Location Last Visit Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Zoned_Location_Record</targetReference>
        </connector>
        <flowName>Get_Target_or_Zone_Last_Visit_Date_Apex</flowName>
        <inputAssignments>
            <name>viT_RequestType</name>
            <value>
                <stringValue>Zoned Location</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>viT_TargetLocation</name>
            <value>
                <elementReference>$Record.Location__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>viT_TargetProvider</name>
            <value>
                <elementReference>$Record.Provider__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>viT_TerritoryOwner</name>
            <value>
                <elementReference>$Record.Territory__r.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
</Flow>
