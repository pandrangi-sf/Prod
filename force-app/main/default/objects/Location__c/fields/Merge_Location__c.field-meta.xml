<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Merge_Location__c</fullName>
    <deleteConstraint>SetNull</deleteConstraint>
    <inlineHelpText>Select the location record this one should be merged into.</inlineHelpText>
    <label>Merge Location</label>
    <lookupFilter>
        <active>true</active>
        <errorMessage>Can&apos;t select this location.</errorMessage>
        <filterItems>
            <field>$Source.Id</field>
            <operation>notEqual</operation>
            <valueField>Location__c.Id</valueField>
        </filterItems>
        <filterItems>
            <field>Location__c.Duplicate__c</field>
            <operation>notEqual</operation>
            <value>True</value>
        </filterItems>
        <isOptional>false</isOptional>
    </lookupFilter>
    <referenceTo>Location__c</referenceTo>
    <relationshipLabel>Locations</relationshipLabel>
    <relationshipName>DuplicateLocations</relationshipName>
    <required>false</required>
    <trackFeedHistory>false</trackFeedHistory>
    <trackHistory>true</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Lookup</type>
</CustomField>
