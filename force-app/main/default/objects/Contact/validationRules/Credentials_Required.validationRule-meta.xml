<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Credentials_Required</fullName>
    <active>true</active>
    <description>Requires Credentials for new records.</description>
    <errorConditionFormula>AND(ISNEW(), ISBLANK(TEXT(Credentials__c)))</errorConditionFormula>
    <errorDisplayField>Credentials__c</errorDisplayField>
    <errorMessage>Credentials required for new records.</errorMessage>
</ValidationRule>
