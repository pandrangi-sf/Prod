<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Affiliation_Required_For_New_Records</fullName>
    <active>true</active>
    <description>Requires the Affiliation field when creating new records.</description>
    <errorConditionFormula>AND(ISNEW(), TEXT(Region__c)=&quot;Florida&quot;,  ISBLANK(TEXT(Affiliation__c)))</errorConditionFormula>
    <errorDisplayField>Affiliation__c</errorDisplayField>
    <errorMessage>Affiliation is required when creating a new provider.</errorMessage>
</ValidationRule>
