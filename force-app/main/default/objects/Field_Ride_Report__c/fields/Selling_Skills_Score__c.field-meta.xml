<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Selling_Skills_Score__c</fullName>
    <description>Calculates the total score for the Selling Skills section by adding the score of each question and dividing by the total number of questions.</description>
    <externalId>false</externalId>
    <formula>(VALUE(TEXT(Use_of_Consultative_Approach__c)) + VALUE(TEXT(Use_of_Questions_and_Fact_Finding__c)) + 
VALUE(TEXT(Demonstrates_Effective_Listing_Skills__c)) + VALUE(TEXT(Presents_Key_Messages__c)) +
VALUE(TEXT(Closes_Effectively_Asking_for_Action__c ))) / 5</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Average score for the questions in this section.</inlineHelpText>
    <label>Selling Skills Score</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
