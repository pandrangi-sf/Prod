<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Provider_Mismatch__c</fullName>
    <description>Checks if the provider on the Target Zone matches the Provider on the PLO.</description>
    <formula>IF(Provider__r.Id =  TargetLocation__r.Provider__r.Id, FALSE,TRUE)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Provider Mismatch</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
