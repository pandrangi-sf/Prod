<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Enforce_Unique_Values</fullName>
    <active>true</active>
    <errorConditionFormula>AND(VLOOKUP($ObjectType.Objection__c.Fields.Name  , $ObjectType.Objection__c.Fields.Name, Name) = Name, OR(ISNEW(), ISCHANGED(Name)))</errorConditionFormula>
    <errorDisplayField>Name</errorDisplayField>
    <errorMessage>This value already exists.</errorMessage>
</ValidationRule>
