<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Estimated_Hours__c</fullName>
    <description>Formula field to display estimated hours based on the t-shirt size.</description>
    <externalId>false</externalId>
    <formula>CASE(
    TEXT(agf__T_Shirt_Size__c),
    &quot;Small&quot;, &quot;20&quot;,
    &quot;Medium&quot;, &quot;40&quot;,
    &quot;Large&quot;, &quot;60&quot;,
    &quot;Extra Large&quot;, &quot;80+&quot;,
    NULL
)</formula>
    <inlineHelpText>Estimated hours based on the T-shirt size.</inlineHelpText>
    <label>Estimated Hours</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
