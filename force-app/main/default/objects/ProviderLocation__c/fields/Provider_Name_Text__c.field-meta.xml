<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Provider_Name_Text__c</fullName>
    <description>Creates a concatenated text version of the Provider&apos;s name.  Used in the Provider Log a Visit Flow when displaying additional providers.</description>
    <externalId>false</externalId>
    <formula>Provider__r.FirstName &amp; &quot; &quot; &amp; Provider__r.MiddleName &amp; &quot; &quot; &amp; Provider__r.LastName &amp; &quot; &quot; &amp; Provider__r.Suffix &amp; &quot; &quot; &amp; TEXT(Provider__r.Credentials__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Provider Name Text</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
